# Copy this file to .env and fill in the values. .env is gitignored; this file is not.
GROQ_API_KEY=
# Local Docker Postgres. Use 127.0.0.1, not localhost (decisions.md #15).
DATABASE_URL=postgresql+pg8000://cfcoach:cfcoach@127.0.0.1:5432/cfcoach
# Local Docker Redis (rate limiter, cache, queue).
REDIS_URL=redis://127.0.0.1:6379/0
# Optional: which Groq model the agent uses (default openai/gpt-oss-120b).
# LLM_MODEL=openai/gpt-oss-120b
